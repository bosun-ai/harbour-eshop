# Public TLS listener (only this container publishes port 8002).
GATEWAY_BIND_ADDRESS=0.0.0.0:8002
GATEWAY_PUBLIC_CERT_PEM=/run/secrets/public-certificate.crt
GATEWAY_PUBLIC_KEY_PEM=/run/secrets/public-private.key

# Private Harbour HTTPS origin and its separately delivered CA certificate.
GATEWAY_LEGACY_URL=https://legacy:8002
GATEWAY_UPSTREAM_CA_PEM=/run/secrets/legacy-certificate.crt
GATEWAY_UPSTREAM_TLS_SERVER_NAME=legacy

GATEWAY_CONNECT_TIMEOUT_SECS=5
GATEWAY_REQUEST_TIMEOUT_SECS=30
GATEWAY_RESPONSE_IDLE_TIMEOUT_SECS=30
GATEWAY_LOG_LEVEL=info
# Empty means every request remains owned by Harbour.
GATEWAY_ENABLED_SLICES=
